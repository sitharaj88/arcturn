{
  "name": "arcturn-monorepo",
  "private": true,
  "version": "0.5.4",
  "description": "Arcturn (✦) — the agent harness where every turn counts",
  "license": "Apache-2.0",
  "author": "Sitharaj Seenivasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/arcturn.git"
  },
  "bugs": {
    "url": "https://github.com/sitharaj88/arcturn/issues"
  },
  "homepage": "https://arcturn.dev",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "check": "biome check . && pnpm -r run typecheck && node scripts/check-sdk-docs.mjs",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
