{
  "name": "arcturn-vscode",
  "displayName": "Arcturn",
  "description": "The Arcturn coding agent in VS Code \u2014 terminal integration, native sidebar, and honest cost accounting, all driven by the same engine as the CLI.",
  "version": "0.1.0",
  "private": true,
  "publisher": "arcturn",
  "license": "Apache-2.0",
  "author": "Sitharaj Seenivasan",
  "homepage": "https://arcturn.dev",
  "bugs": {
    "url": "https://github.com/sitharaj88/arcturn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/arcturn.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "arcturn",
    "ai",
    "agent",
    "chat",
    "terminal"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0A08",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Arcturn runs an agent that reads and edits this workspace and executes shell commands in it. That is not something to offer in a folder you have not trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The engine is a local process operating on real files; a virtual filesystem has nothing for it to run against."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "arcturn.open",
        "title": "Open",
        "category": "Arcturn",
        "icon": "$(sparkle)"
      },
      {
        "command": "arcturn.sendSelection",
        "title": "Send Selection",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.sendFile",
        "title": "Send File",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.installCli",
        "title": "Install CLI",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.fixDiagnostic",
        "title": "Fix with Arcturn",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.selectModel",
        "title": "Select Model",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.showSessions",
        "title": "Show Sessions",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.newSession",
        "title": "New Session",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.abortRun",
        "title": "Abort Run",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.showCost",
        "title": "Show Cost",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.showDiff",
        "title": "Review Pending Changes",
        "category": "Arcturn",
        "icon": "$(diff)"
      },
      {
        "command": "arcturn.applyChanges",
        "title": "Apply Pending Changes",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.discardChanges",
        "title": "Discard Pending Changes",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.reconnect",
        "title": "Reconnect",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.showLog",
        "title": "Show Log",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.toggleActiveEditorContext",
        "title": "Toggle Active File Context",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.authorizeMcpServer",
        "title": "Authorize MCP Server",
        "category": "Arcturn"
      },
      {
        "command": "arcturn.hub.install",
        "title": "Install Kit",
        "category": "Arcturn",
        "icon": "$(cloud-download)"
      },
      {
        "command": "arcturn.hub.openOnWeb",
        "title": "Open on arcturn.dev",
        "category": "Arcturn",
        "icon": "$(link-external)"
      },
      {
        "command": "arcturn.hub.refresh",
        "title": "Refresh Hub",
        "category": "Arcturn",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "arcturn.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "arcturn.sendSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "arcturn.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "arcturn.selectModel",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.showSessions",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.newSession",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.abortRun",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.showCost",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.showDiff",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.applyChanges",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.discardChanges",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.reconnect",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.showLog",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.toggleActiveEditorContext",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.authorizeMcpServer",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.hub.refresh",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "command": "arcturn.hub.install",
          "when": "false"
        },
        {
          "command": "arcturn.hub.openOnWeb",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "arcturn.sendSelection",
          "when": "editorHasSelection",
          "group": "arcturn@1"
        },
        {
          "command": "arcturn.sendFile",
          "when": "resourceScheme == file",
          "group": "arcturn@2"
        }
      ],
      "explorer/context": [
        {
          "command": "arcturn.sendFile",
          "when": "!explorerResourceIsFolder && resourceScheme == file",
          "group": "arcturn@1"
        }
      ],
      "view/title": [
        {
          "command": "arcturn.hub.refresh",
          "when": "view == arcturn.hub",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "arcturn.hub.install",
          "when": "view == arcturn.hub && viewItem =~ /^arcturn\\.hub\\.kit\\.(available|partial)$/",
          "group": "inline"
        },
        {
          "command": "arcturn.hub.openOnWeb",
          "when": "view == arcturn.hub && viewItem =~ /^arcturn\\.hub\\.kit\\./",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arcturn",
          "title": "Arcturn",
          "icon": "media/arcturn-activity.svg"
        }
      ]
    },
    "views": {
      "arcturn": [
        {
          "id": "arcturn.sidebar",
          "name": "Chat",
          "type": "webview",
          "when": "config.arcturn.serve.enabled"
        },
        {
          "id": "arcturn.hub",
          "name": "Hub",
          "icon": "$(package)",
          "when": "config.arcturn.serve.enabled"
        }
      ]
    },
    "configuration": {
      "title": "Arcturn",
      "properties": {
        "arcturn.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `arcturn` executable. Leave empty to search your `PATH`. A leading `~` is expanded. If this points at something that is not runnable, Arcturn says so rather than quietly falling back to `PATH` \u2014 you would otherwise be running a different engine than the one you named."
        },
        "arcturn.defaultModel": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Model id passed to the engine as `--model` when a terminal is launched from this extension. Leave empty to use the engine's own default from `~/.arcturn`. The extension never writes that config."
        },
        "arcturn.serve.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Run `arcturn serve` for the native sidebar. Turn this off for terminal integration only; the Arcturn view disappears with it."
        },
        "arcturn.context.activeEditor": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Include the file you have open in the Arcturn panel, as a chip you can see before you send. The panel shows the file \u2014 and the line range, when you have a selection \u2014 and the engine reads it from its path the way any other attachment is read; the extension never reads it. Turn this off to keep the panel from watching your editor. `Arcturn: Toggle Active File Context` and the chip's own dismiss control do the same thing.\n\nNote: the engine's attachment carries a path and no line range, so a selection sends the whole file. The chip says so rather than implying otherwise."
        },
        "arcturn.serve.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "scope": "window",
          "markdownDescription": "Loopback port for `arcturn serve`. `0` picks an ephemeral port, which is the recommended setting \u2014 a fixed port is one more thing another process on this machine can find."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "arcturn.getStarted",
        "title": "Get started with Arcturn",
        "description": "Install the engine, point it at a model, and ask it something.",
        "steps": [
          {
            "id": "engine",
            "title": "Install the engine",
            "description": "The extension is a client. The `arcturn` CLI is the agent, and the panel needs 0.4.0 or newer.\n[Install CLI](command:arcturn.installCli)",
            "media": {
              "markdown": "media/walkthrough/engine.md"
            },
            "completionEvents": [
              "onCommand:arcturn.installCli"
            ]
          },
          {
            "id": "key",
            "title": "Point it at a model",
            "description": "Arcturn reads provider keys from your environment. Export one, then check what the engine can reach.\n[Select Model](command:arcturn.selectModel)",
            "media": {
              "markdown": "media/walkthrough/key.md"
            },
            "completionEvents": [
              "onCommand:arcturn.selectModel"
            ]
          },
          {
            "id": "panel",
            "title": "Ask it something",
            "description": "Open the panel and type. The file you have open is named, not sent \u2014 and nothing is written without a prompt you answer.\n[Open Arcturn](command:arcturn.open)",
            "media": {
              "markdown": "media/walkthrough/panel.md"
            },
            "completionEvents": [
              "onCommand:arcturn.open",
              "onCommand:arcturn.sendSelection"
            ]
          },
          {
            "id": "skills",
            "title": "Teach it your work",
            "description": "Kits are roles and workflows kept as files you can read and version. Thirteen of them are on the hub.\n[Browse the hub](https://arcturn.dev/hub)",
            "media": {
              "markdown": "media/walkthrough/skills.md"
            },
            "completionEvents": [
              "onLink:https://arcturn.dev/hub"
            ]
          },
          {
            "id": "mcp",
            "title": "Connect your tools",
            "description": "MCP servers give the agent real capabilities. OAuth works even when the engine is on another machine.\n[Authorize MCP Server](command:arcturn.authorizeMcpServer)",
            "media": {
              "markdown": "media/walkthrough/mcp.md"
            },
            "completionEvents": [
              "onCommand:arcturn.authorizeMcpServer"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "catalog": "node scripts/build-catalog.mjs",
    "build:integration": "esbuild test/integration/*.test.ts --bundle --outdir=out/integration --format=cjs --platform=node --external:vscode --sourcemap",
    "clean": "rm -rf dist out .vscode-test *.vsix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.integration.json",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run build",
    "test:integration": "pnpm run build && pnpm run build:integration && vscode-test"
  },
  "dependencies": {
    "@arcturn/protocol": "workspace:*",
    "@arcturn/types": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
