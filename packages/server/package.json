{
  "name": "@arcturn/server",
  "version": "0.5.9",
  "description": "WebSocket server exposing Arcturn agent sessions Internal to the arcturn CLI; API may change in any release.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Sitharaj Seenivasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/arcturn.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/sitharaj88/arcturn/issues"
  },
  "homepage": "https://arcturn.dev",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "@arcturn/core": "workspace:*",
    "@arcturn/protocol": "workspace:*",
    "@arcturn/types": "workspace:*",
    "ws": "^8.21.3"
  }
}
