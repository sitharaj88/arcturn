{
  "name": "@arcturn/ai",
  "version": "0.5.3",
  "description": "Unified multi-provider LLM streaming client for the Arcturn agent harness",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Sitharaj Seenivasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/arcturn.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/sitharaj88/arcturn/issues"
  },
  "homepage": "https://arcturn.dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.4",
    "@anthropic-ai/sdk": "^0.117.1",
    "@anthropic-ai/vertex-sdk": "^0.19.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1112.0",
    "@aws-sdk/credential-providers": "^3.1112.0",
    "@google/genai": "^2.17.1",
    "@arcturn/types": "workspace:*",
    "google-auth-library": "^11.0.2",
    "openai": "^7.5.0"
  }
