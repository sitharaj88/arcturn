{
  "name": "@arcturn/core",
  "version": "0.5.5",
  "description": "Arcturn agent runtime: event loop, sessions, compaction, permissions, sub-agents",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Sitharaj Seenivasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitharaj88/arcturn.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sitharaj88/arcturn/issues"
  },
  "homepage": "https://arcturn.dev",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
